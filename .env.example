# Application
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-string-in-production
JWT_SECRET_KEY=change-this-to-another-secure-random-string
JWT_EXPIRATION_HOURS=8

# Database
DATABASE_URL=sqlite:///complaints.db

# ML Model
MODEL_PATH=ml/models/classifier.joblib
VECTORIZER_PATH=ml/models/vectorizer.joblib
CONFIDENCE_THRESHOLD=0.60
MODEL_TYPE=tfidf_lr

# CFPB Dataset
CFPB_DATA_PATH=ml/data/cfpb_complaints.csv
CFPB_SAMPLE_SIZE=50000

# Server
HOST=0.0.0.0
PORT=5000

# Demo accounts (development only - never use in production)
DEMO_ADMIN_PASSWORD=admin123dev
DEMO_MANAGER_PASSWORD=manager123dev
DEMO_AGENT_PASSWORD=agent123dev
